# cp .env.example .env 로 복사한 뒤 실제 값을 채우세요. .env 는 커밋되지 않습니다.

# --- DB ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=여기에_강한_비밀번호
POSTGRES_DB=tuk

# --- JWT (HS256 이라 최소 32바이트. 예: openssl rand -base64 48) ---
JWT_SECRET=여기에_32바이트_이상_랜덤_문자열

# --- 도메인 (Caddy 가 이 이름으로 HTTPS 인증서를 발급받는다) ---
# 이 도메인의 A 레코드가 서버 공인 IP 를 가리키고 있어야 발급된다.
TUK_DOMAIN=tuk.example.com

# --- CORS: 웹(Next.js) 오리진. 쉼표로 여러 개 ---
CORS_ALLOWED_ORIGINS=https://tuk.example.com

# --- FCM: 서비스 계정 키를 이 디렉터리에 firebase-service-account.json 으로 두고 true ---
FCM_ENABLED=false
