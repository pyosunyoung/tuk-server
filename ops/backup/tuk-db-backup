#!/usr/bin/env bash
# 툭 PostgreSQL 일일 백업 — tuk-db-backup.timer 가 매일 04:00 KST 에 실행.
#   1) 서버 디스크: /var/backups/tuk, 14일 보관 (실수로 지운 데이터를 빨리 살리는 용도)
#   2) 외부 사본: 암호화해서 Backblaze B2, 30일 보관 (서버가 통째로 사라져도 남는 용도)
# 외부 사본 설정(/etc/tuk/backup-offsite.env)이 없으면 1) 만 한다.
set -euo pipefail

DIR=/var/backups/tuk
KEEP_DAYS=14
TS=$(TZ=Asia/Seoul date +%Y%m%d-%H%M)
OUT="$DIR/tuk-$TS.dump"

# 커스텀 포맷(-Fc): 압축되고 pg_restore 로 테이블 단위 복구 가능.
# 임시 파일에 쓰고 검증 후 이름을 바꿔, 실패한 백업이 정상 파일처럼 남지 않게 한다.
docker exec tuk-postgres pg_dump -U postgres -d tuk -Fc > "$OUT.partial"
docker exec -i tuk-postgres pg_restore --list < "$OUT.partial" > /dev/null
mv "$OUT.partial" "$OUT"
chmod 600 "$OUT"

find "$DIR" -name "tuk-*.dump" -mtime +"$KEEP_DAYS" -delete
find "$DIR" -name "*.partial" -mmin +60 -delete

echo "백업 완료: $OUT ($(du -h "$OUT" | cut -f1)), 보관 $(ls "$DIR"/tuk-*.dump | wc -l)개"

# ── 외부 사본 ──────────────────────────────────────────────────────────────
# backup-offsite.env (root 600):
#   B2_BUCKET=버킷 이름
#   B2_KEY_ID=…  B2_APP_KEY=…      (이 버킷 전용 앱 키)
#   AGE_RECIPIENT=age1…            (공개 키 — 암호화만 가능. 풀 수 있는 개인 키는 서버에 두지 않는다)
#   OFFSITE_KEEP_DAYS=30           (선택)
ENV_FILE=/etc/tuk/backup-offsite.env
if [[ ! -f "$ENV_FILE" ]]; then
  echo "외부 사본 설정 없음($ENV_FILE) — 서버 디스크에만 저장"
  exit 0
fi
# shellcheck source=/dev/null
source "$ENV_FILE"
OFFSITE_KEEP_DAYS=${OFFSITE_KEEP_DAYS:-30}

# rclone 설정 파일 없이 환경 변수로 원격(b2:)을 정의한다 — 비밀은 env 파일 한 곳에만.
export RCLONE_CONFIG_B2_TYPE=b2
export RCLONE_CONFIG_B2_ACCOUNT="$B2_KEY_ID"
export RCLONE_CONFIG_B2_KEY="$B2_APP_KEY"
# 지운 파일이 B2 에 '숨김 버전'으로 남아 용량을 차지하지 않게 바로 지운다
export RCLONE_CONFIG_B2_HARD_DELETE=true

ENC="$OUT.age.partial"
trap 'rm -f "$ENC"' EXIT
age -r "$AGE_RECIPIENT" -o "$ENC" "$OUT"

REMOTE="b2:$B2_BUCKET/tuk-$TS.dump.age"
rclone copyto "$ENC" "$REMOTE"

# 올라간 크기가 로컬과 같은지 확인(중간에 끊긴 업로드를 성공으로 치지 않는다)
local_size=$(stat -c %s "$ENC")
remote_size=$(rclone size --json "$REMOTE" | sed -n 's/.*"bytes":\([0-9]*\).*/\1/p')
if [[ "$local_size" != "$remote_size" ]]; then
  echo "외부 사본 크기 불일치: 로컬 $local_size, B2 ${remote_size:-없음}" >&2
  exit 1
fi

rclone delete --min-age "${OFFSITE_KEEP_DAYS}d" --include "tuk-*.dump.age" "b2:$B2_BUCKET"
echo "외부 사본 완료: $REMOTE ($local_size bytes), B2 보관 $(rclone lsf --include 'tuk-*.dump.age' "b2:$B2_BUCKET" | wc -l)개"
